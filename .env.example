# Site URL for canonicals, Open Graph, Twitter, JSON-LD, sitemap, and robots.txt.
# Default fallback if unset: https://highsol.pages.dev
NEXT_PUBLIC_SITE_URL=https://highsol.pages.dev

# Search engine and AI crawler indexing control.
# Set to "false" (default) for staging, previews, and internal design reviews (outputs noindex, nofollow and Disallow: /).
# Set to "true" only when authorized for production launch on the verified domain (outputs index, follow, allows search & AI bots, and advertises sitemap.xml).
NEXT_PUBLIC_SITE_INDEXABLE=false

# Formspree endpoint ID for RFQ / Contact submissions.
# When unset, the form operates in visual preview mode.
NEXT_PUBLIC_FORMSPREE_ID=

# Business contact coordinates
NEXT_PUBLIC_HIGHSOL_EMAIL=inquiry@highsol.example
NEXT_PUBLIC_HIGHSOL_WHATSAPP=
